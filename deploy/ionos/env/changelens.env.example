# /etc/changelens/changelens.env (root:root, mode 600). Read by the api and retention. The worker has its own
# file, worker.env, which repeats the database URL, the four S3 lines and the two spend caps: change them in
# both files.
# Never set CHANGELENS_ENV=local or CHANGELENS_DEV_TOKEN here: logto mode refuses a dev token.
# The database URL, the four S3 lines and CHANGELENS_LLM have no default in logto mode: the processes
# stop at start when one is missing or empty, and CHANGELENS_LLM=fake is refused.
CHANGELENS_DATABASE_URL=postgresql+psycopg://changelens_app:<app>@postgres:5432/changelens

CHANGELENS_AUTH_MODE=logto
CHANGELENS_LOGTO_ISSUER=https://auth.pixeltronic.dev/oidc
CHANGELENS_LOGTO_AUDIENCE=https://api.pixeltronic.dev
CHANGELENS_LOGTO_JWKS_URL=https://auth.pixeltronic.dev/oidc/jwks
CHANGELENS_LOGTO_MANAGEMENT_ENDPOINT=https://auth.pixeltronic.dev
# The machine-to-machine app with the Logto Management API role (README step C5).
CHANGELENS_LOGTO_M2M_APP_ID=
CHANGELENS_LOGTO_M2M_APP_SECRET=
# 32+ random characters: openssl rand -hex 32
CHANGELENS_RATE_LIMIT_KEY=
# Caddy's fixed address on the edge network (compose.yaml).
CHANGELENS_TRUSTED_PROXIES=172.30.0.2

# Native Google and Apple sign-in (I-8 S4; README step C8). Commented out = off; email sign-in works without
# them. Set all of a provider's lines or none. The files are in /etc/changelens/signin/, which the api and
# retention see read-only at /run/signin. Google: the web (server) client the apps request codes for.
# CHANGELENS_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# CHANGELENS_GOOGLE_CLIENT_SECRET_FILE=/run/signin/google-client-secret
# Apple: the app's bundle ID, your Team ID, the Sign in with Apple key's ID, the key, and the keyring that
# encrypts stored Apple refresh tokens.
# CHANGELENS_APPLE_CLIENT_ID=dev.changelens.app
# CHANGELENS_APPLE_TEAM_ID=XXXXXXXXXX
# CHANGELENS_APPLE_KEY_ID=XXXXXXXXXX
# CHANGELENS_APPLE_PRIVATE_KEY_FILE=/run/signin/apple-signin.p8
# CHANGELENS_APPLE_TOKEN_KEYS_FILE=/run/signin/apple-token-keys.json

# IONOS Object Storage, Frankfurt (the backend signs for region eu-central-1).
CHANGELENS_S3_ENDPOINT=https://s3.eu-central-1.ionoscloud.com
CHANGELENS_S3_BUCKET=changelens-originals
CHANGELENS_S3_ACCESS_KEY=
CHANGELENS_S3_SECRET_KEY=

CHANGELENS_LLM=ionos
CHANGELENS_TENANT_SPEND_CAP_EUR=5
CHANGELENS_GLOBAL_SPEND_CAP_EUR=50
