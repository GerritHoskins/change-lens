# /etc/changelens/admin.env (root:root, mode 600). Only the one-off tools read this: bootstrap-roles and migrate.
# The running api, worker and retention never see the superuser or owner passwords.
# <superuser> is POSTGRES_PASSWORD from postgres.env; <owner> and <app> are new values (16+ characters).
CHANGELENS_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:<superuser>@postgres:5432/changelens
CHANGELENS_MIGRATION_DATABASE_URL=postgresql+psycopg://changelens_owner:<owner>@postgres:5432/changelens
CHANGELENS_OWNER_DB_PASSWORD=
CHANGELENS_APP_DB_PASSWORD=
