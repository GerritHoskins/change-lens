# /etc/changelens/umami.env (root:root, mode 600). Only for the `stats` profile (landing page measurement).
# <umami> is UMAMI_DB_PASSWORD from postgres.env. Generate APP_SECRET with: openssl rand -hex 32
# Umami doesn't start without both. The other settings are fixed in compose.yaml.
DATABASE_URL=postgresql://umami:<umami>@postgres:5432/umami
APP_SECRET=
