# /etc/changelens/worker.env (root:root, mode 600). The worker reads this file and no other: it parses uploaded
# files, so it gets the database, the storage and the model, and nothing about sign-in. It stops at start when
# it finds CHANGELENS_LOGTO_M2M_APP_ID, CHANGELENS_LOGTO_M2M_APP_SECRET, CHANGELENS_RATE_LIMIT_KEY,
# CHANGELENS_SMTP_PASSWORD or CHANGELENS_EARLY_BIRD_UNSUBSCRIBE_KEY here.
# The database URL, the four S3 lines and the two spend caps are the same values as in changelens.env: change
# them in both files.
CHANGELENS_AUTH_MODE=logto
CHANGELENS_DATABASE_URL=postgresql+psycopg://changelens_app:<app>@postgres:5432/changelens

CHANGELENS_S3_ENDPOINT=https://s3.eu-central-1.ionoscloud.com
CHANGELENS_S3_BUCKET=changelens-originals
CHANGELENS_S3_ACCESS_KEY=
CHANGELENS_S3_SECRET_KEY=

CHANGELENS_LLM=ionos
CHANGELENS_TENANT_SPEND_CAP_EUR=5
CHANGELENS_GLOBAL_SPEND_CAP_EUR=50
# The model key. The worker alone reads it.
IONOS_API_TOKEN=
