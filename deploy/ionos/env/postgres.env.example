# /etc/changelens/postgres.env (root:root, mode 600). The Postgres superuser, Logto's database password, the
# backup role's password and Umami's database password (only needed with the `stats` profile).
# Generate each value with: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
POSTGRES_USER=postgres
POSTGRES_DB=changelens
POSTGRES_PASSWORD=
LOGTO_DB_PASSWORD=
BACKUP_DB_PASSWORD=
UMAMI_DB_PASSWORD=
