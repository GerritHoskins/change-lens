# /etc/changelens/backup.env (root:root, mode 600). Read by the backup job and the restore test.
# Postgres superuser, for pg_basebackup and the Logto audit-log pruning (same value as POSTGRES_PASSWORD).
PGHOST=postgres
PGUSER=postgres
PGPASSWORD=
# The public half of the backup key (README step B6): every backup is encrypted to it before upload.
AGE_RECIPIENT=
# IONOS Object Storage, a separate key pair limited to the backup bucket if IONOS allows it.
RCLONE_CONFIG_IONOS_TYPE=s3
RCLONE_CONFIG_IONOS_PROVIDER=IONOS
RCLONE_CONFIG_IONOS_ENDPOINT=https://s3.eu-central-1.ionoscloud.com
RCLONE_CONFIG_IONOS_REGION=eu-central-1
RCLONE_CONFIG_IONOS_ACCESS_KEY_ID=
RCLONE_CONFIG_IONOS_SECRET_ACCESS_KEY=
BACKUP_BUCKET=changelens-backups
