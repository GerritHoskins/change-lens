# /etc/changelens/backup.env (root:root, mode 600). Read by the backup job and the restore test.
# The backup role (postgres/init/20-backup-role.sh): it may take base backups and have rows older than 30 days
# deleted from Logto's audit log, nothing else. PGPASSWORD is the same value as BACKUP_DB_PASSWORD in postgres.env.
PGHOST=postgres
PGUSER=changelens_backup
PGPASSWORD=
# The public half of the backup key (README step B6): every backup is encrypted to it before upload.
AGE_RECIPIENT=
# IONOS Object Storage: the key of the backup job's own IONOS user, which a bucket policy lets into the
# backup bucket only (one-off-releases.md, "Separate storage keys"). Not the app's key and not the owner's.
RCLONE_CONFIG_IONOS_TYPE=s3
RCLONE_CONFIG_IONOS_PROVIDER=IONOS
RCLONE_CONFIG_IONOS_ENDPOINT=https://s3.eu-central-1.ionoscloud.com
RCLONE_CONFIG_IONOS_REGION=eu-central-1
RCLONE_CONFIG_IONOS_ACCESS_KEY_ID=
RCLONE_CONFIG_IONOS_SECRET_ACCESS_KEY=
BACKUP_BUCKET=changelens-backups
